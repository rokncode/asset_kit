# lowest (downgrade) and newest (upgrade) dependency versions.
pubspec.lock
coverage/

# asset_kit's own cache and backups (also inside fixture copies)
.asset_kit/
*.asset_kit.tmp

# OS / editors
.DS_Store
.idea/
.vscode/
*.iml
*.swp

# Not published: the fixture is a stand-in Flutter app used only by the
# tests (it imports package:flutter, which this package does not depend on).
test/fixtures/
